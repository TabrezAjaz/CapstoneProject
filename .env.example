# Sprint 2 CI/CD scanner overrides (copy to .env for local reference only)
SCAN_IMAGE=alpine:3.19
SCANNER_CONFIG=config.yaml
SCANNER_SEVERITIES=LOW,MEDIUM,HIGH,CRITICAL
SCANNER_FAIL_ON=HIGH
SCANNER_IGNORE_UNFIXED=false
SCANNER_PKG_TYPES=os
SCANNER_TIMEOUT=15m
SCANNER_RETRIES=2
SCANNER_RETRY_BACKOFF=1
SCANNER_EXCEPTIONS_FILE=exceptions/allowlist.yaml
SCANNER_OUTPUT_DIR=scan-results
REPORT_OUTPUT_DIR=reports
REPORT_FORMATS=json,html,pdf
NOTIFICATION_ALERT_ON=HIGH
# Store the real value only in GitHub/Jenkins secrets or the process environment.
SLACK_WEBHOOK_URL=
SCANNER_HISTORY_DB=dashboard/data/history.sqlite3
