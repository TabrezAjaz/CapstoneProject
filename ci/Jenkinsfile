pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: true)
    }

    parameters {
        string(name: 'SCAN_IMAGE', defaultValue: 'alpine:3.19', description: 'Container image reference')
        choice(name: 'SCANNER_FAIL_ON', choices: ['HIGH', 'CRITICAL', 'MEDIUM', 'LOW'], description: 'Minimum blocking severity')
    }

    environment {
        TRIVY_VERSION = '0.74.0'
        SCANNER_OUTPUT_DIR = 'scan-results'
        SCANNER_TIMEOUT = '15m'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Environment') {
            steps {
                sh '''
                    rm -rf .ci-python .tools
                    mkdir -p .ci-python .tools
                    python3 -m pip install --disable-pip-version-check --target .ci-python -r requirements-dev.txt
                    curl -sfL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
                      | tar -xz -C .tools trivy
                    .tools/trivy --version
                '''
            }
        }

        stage('Refresh vulnerability DB') {
            steps {
                retry(2) {
                    sh '.tools/trivy image --download-db-only'
                }
            }
        }

        stage('Tests') {
            steps {
                sh 'PYTHONPATH=.ci-python python3 -m pytest -q --junitxml=test-results/junit.xml'
            }
        }

        stage('Vulnerability Gate') {
            steps {
                sh 'PATH="$WORKSPACE/.tools:$PATH" PYTHONPATH=.ci-python python3 -m scanner.trivy_scanner "$SCAN_IMAGE"'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'test-results/junit.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'scan-results/*.json', fingerprint: true
        }
        cleanup {
            deleteDir()
        }
    }
}
