<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ document.title }}</title><style>
body{font:15px/1.5 Segoe UI,Arial;color:#172033;margin:0;background:#f4f7f8}main{max-width:1100px;margin:auto;background:white;padding:35px}h1,h2{color:#075a54}.hero{background:linear-gradient(135deg,#073b3a,#12314a);color:white;padding:35px;border-bottom:6px solid #21c8b3}.hero h1{color:white}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.metric{padding:15px;border-radius:8px;background:#edf7f5;text-align:center}.metric strong{display:block;font-size:25px}table{width:100%;border-collapse:collapse;margin:18px 0}th,td{border:1px solid #cad8d6;padding:8px;text-align:left}th{background:#dff4f0}.passed{color:#16803a}.blocked,.CRITICAL,.HIGH{color:#b42318}.MEDIUM{color:#a15c00}.LOW{color:#16803a}code{background:#edf7f5;padding:2px 4px}footer{color:#64748b;margin-top:30px;border-top:1px solid #ddd;padding-top:12px}@media print{body{background:white}main{padding:0}}
</style></head><body><main><section class="hero"><h1>{{ document.title }}</h1><p>{{ document.period|title }} security report · {{ document.generated_at }}</p><p>Status: <strong>{{ document.overall.status }}</strong></p></section>
<h2>Executive Summary</h2><div class="grid"><div class="metric"><strong>{{ document.totals.images }}</strong>Images</div><div class="metric"><strong>{{ document.totals.CRITICAL }}</strong>Critical</div><div class="metric"><strong>{{ document.totals.HIGH }}</strong>High</div><div class="metric"><strong>{{ document.totals.MEDIUM }}</strong>Medium</div><div class="metric"><strong>{{ document.totals.LOW }}</strong>Low</div></div>
{% for image in document.images %}<h2>{{ image.image }}</h2><p class="{{ 'passed' if image.policy.passed else 'blocked' }}">Policy {{ 'PASSED' if image.policy.passed else 'BLOCKED' }} · threshold {{ image.policy.fail_on }} · {{ image.policy.blocking_findings }} blocking</p>
<table><thead><tr><th>Severity</th><th>CVE / advisory</th><th>Package</th><th>Installed</th><th>Fixed</th></tr></thead><tbody>{% for finding in image.findings %}<tr><td class="{{ finding.severity }}">{{ finding.severity }}</td><td>{{ finding.id }}</td><td>{{ finding.pkg }}</td><td>{{ finding.installed }}</td><td>{{ finding.fixed or 'Not fixed' }}</td></tr>{% else %}<tr><td colspan="5">No active vulnerabilities detected.</td></tr>{% endfor %}</tbody></table>
{% if image.suppressed_findings %}<h3>Approved exceptions (excluded from gate)</h3><table><thead><tr><th>Severity</th><th>CVE / advisory</th><th>Package</th><th>Reason</th><th>Expires (UTC)</th></tr></thead><tbody>{% for finding in image.suppressed_findings %}<tr><td>{{ finding.severity }}</td><td>{{ finding.id }}</td><td>{{ finding.pkg }}</td><td>{{ finding.exception.reason }}</td><td>{{ finding.exception.expires }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if image.exception_policy and image.exception_policy.expired %}<p class="blocked">{{ image.exception_policy.expired|length }} expired exception(s) were not applied.</p>{% endif %}
{% if image.exception_policy and image.exception_policy.sha256 %}<p>Exception policy: {{ image.exception_policy.file }} &middot; SHA-256 <code>{{ image.exception_policy.sha256 }}</code></p>{% endif %}
{% endfor %}
<footer>Report ID {{ document.report_id }} · Schema {{ document.schema_version }}</footer></main></body></html>
